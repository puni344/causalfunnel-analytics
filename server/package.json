{
  "name": "causalfunnel-server",
  "version": "0.1.0",
  "description": "CausalFunnel User Analytics — backend API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/**/*.test.js"
  },
  "keywords": [
    "analytics",
    "express",
    "mongoose"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongoose": "^9.11.1",
    "zod": "^4.6.7"
  }
}
